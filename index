  // "today" / "yesterday" / "N days ago" for recent gaps, falling back to a plain
  // date once it's far enough back that a day-count stops being useful at a glance.
  function daysAgoLabel(dateKeyStr){
    if(!dateKeyStr) return null;
    if(dateKeyStr === todayKey()) return 'today';
    const [y,m,d] = dateKeyStr.split('-').map(Number);
    const then = new Date(y, m-1, d);
    const now = new Date(); now.setHours(0,0,0,0);
    const diffDays = Math.round((now - then) / 86400000);
    if(diffDays < 0) return dateKeyStr;
    if(diffDays === 1) return 'yesterday';
    if(diffDays < 30) return `${diffDays} days ago`;
    return then.toLocaleDateString(undefined, {dateStyle:'medium'});
  }

