<script>
(function(){
  const STORAGE_KEY = 'grindLogData';
  const DEFAULT_GOALS = [
    { id:'goal_1', text:'20 quality Quant questions', archived:false },
    { id:'goal_2', text:'3–4 quality LRDI sets', archived:false },
    { id:'goal_3', text:'3 RCs + 5–6 VA questions (VARC)', archived:false },
    { id:'goal_4', text:'45 mins of reading', archived:false },
    { id:'goal_5', text:"Plan tomorrow's targets before bed", archived:false }
  ];
  const DOW = ['S','M','T','W','T','F','S'];

  function normalizeData(raw){
    if(!raw || typeof raw !== 'object'){
      raw = {};
    }
    raw.settings = (raw.settings && typeof raw.settings==='object') ? raw.settings : {};
    if(!raw.settings.catDate) raw.settings.catDate = '2026-11-29';
    if(!raw.settings.dailyTargetMinutes || isNaN(raw.settings.dailyTargetMinutes)) raw.settings.dailyTargetMinutes = 240;
    raw.settings.targetPercentile = (raw.settings.targetPercentile && typeof raw.settings.targetPercentile==='object')
      ? raw.settings.targetPercentile : {VARC:null, Quant:null, LRDI:null, Overall:null};
    ['VARC','Quant','LRDI','Overall'].forEach(sec=>{
      if(raw.settings.targetPercentile[sec]===undefined) raw.settings.targetPercentile[sec] = null;
    });
    raw.settings.targetScore = (raw.settings.targetScore!==null && raw.settings.targetScore!==undefined && !isNaN(parseFloat(raw.settings.targetScore)))
      ? parseFloat(raw.settings.targetScore) : null;
    raw.days = (raw.days && typeof raw.days==='object') ? raw.days : {};
    Object.keys(raw.days).forEach(k=>{
      if(!raw.days[k] || !Array.isArray(raw.days[k].sessions)) raw.days[k] = {sessions:[], targetMinutesAtStart: raw.settings.dailyTargetMinutes};
      raw.days[k].sessions = raw.days[k].sessions
        .filter(s => s && typeof s==='object' && typeof s.durationSec==='number' && !isNaN(s.durationSec))
        .map(s => ({
          id: s.id || ('sess_'+Math.random().toString(36).slice(2,10)),
          start: s.start || (k+'T12:00:00.000Z'),
          end: s.end || s.start || (k+'T12:00:00.000Z'),
          durationSec: s.durationSec,
          manual: !!s.manual
        }));
    });
    // Derived, not trusted from storage - a stored value can go stale (e.g. after
    // deleting the very session that had set the record), so recompute it from the
    // actual sessions every time rather than carrying forward a number that could
    // no longer correspond to anything that still exists.
    let derivedLongest = 0;
    Object.values(raw.days).forEach(day=>{
      (day.sessions||[]).forEach(s=>{ if(s.durationSec > derivedLongest) derivedLongest = s.durationSec; });
    });
    raw.longestEverSec = derivedLongest;
    if(typeof raw.lastModified !== 'number' || isNaN(raw.lastModified)) raw.lastModified = 0;
    raw.tests = Array.isArray(raw.tests)
      ? raw.tests
          .filter(t => t && typeof t==='object' && t.section && !isNaN(parseFloat(t.score)))
          .map(t => ({
            id: t.id || ('T'+Math.random().toString(36).slice(2,10)),
            date: t.date || '1970-01-01',
            type: (t.type==='mock') ? 'mock' : 'sectional',
            section: t.section,
            mockGroup: t.mockGroup || null,
            series: t.series || 'Other',
            testName: typeof t.testName === 'string' ? t.testName : '',
            score: parseFloat(t.score),
            percentile: (t.percentile===null || t.percentile===undefined || isNaN(parseFloat(t.percentile))) ? null : parseFloat(t.percentile),
            timeTakenMin: (t.timeTakenMin===null || t.timeTakenMin===undefined || isNaN(parseFloat(t.timeTakenMin))) ? null : parseFloat(t.timeTakenMin),
            attempted: (t.attempted===null || t.attempted===undefined || isNaN(parseFloat(t.attempted))) ? null : parseFloat(t.attempted),
            correct: (t.correct===null || t.correct===undefined || isNaN(parseFloat(t.correct))) ? null : parseFloat(t.correct),
            wrong: (t.wrong===null || t.wrong===undefined || isNaN(parseFloat(t.wrong))) ? null : parseFloat(t.wrong),
            errorTag: t.errorTag || null,
            notes: typeof t.notes === 'string' ? t.notes : ''
          }))
      : [];
    raw.activeSession = (raw.activeSession && raw.activeSession.start) ? raw.activeSession : null;

    // Daily targets checklist — seeded once with your given goals if this data has never had any.
    // Existing goals (if present) are kept exactly as-is, just sanitized.
    raw.goals = Array.isArray(raw.goals) && raw.goals.length
      ? raw.goals
          .filter(g => g && typeof g==='object' && typeof g.text==='string' && g.text.trim())
          .map(g => ({ id: g.id || ('goal_'+Math.random().toString(36).slice(2,9)), text: g.text, archived: !!g.archived }))
      : DEFAULT_GOALS.map(g => ({...g}));

    raw.goalLogs = (raw.goalLogs && typeof raw.goalLogs==='object') ? raw.goalLogs : {};
    Object.keys(raw.goalLogs).forEach(day=>{
      const dayLog = raw.goalLogs[day];
      if(!dayLog || typeof dayLog !== 'object'){ raw.goalLogs[day] = {}; return; }
      Object.keys(dayLog).forEach(gid=>{ dayLog[gid] = !!dayLog[gid]; });
    });

    // Practice log: subject > topic > sub-topic, with a running question count per
    // entry. Topics/sub-topics are user-defined (no preset syllabus) - each is just
    // a name + stable id, and logs reference the id (not the name) so a later rename
    // doesn't fragment historical totals the way re-typing a name each time would.
    raw.practice = (raw.practice && typeof raw.practice==='object') ? raw.practice : {};
    raw.practice.topics = (raw.practice.topics && typeof raw.practice.topics==='object') ? raw.practice.topics : {};
    ['VARC','Quant','LRDI'].forEach(sec=>{
      const list = Array.isArray(raw.practice.topics[sec]) ? raw.practice.topics[sec] : [];
      raw.practice.topics[sec] = list
        .filter(t => t && typeof t==='object' && typeof t.name==='string' && t.name.trim())
        .map(t => ({
          id: t.id || ('topic_'+Math.random().toString(36).slice(2,9)),
          name: t.name.trim(),
          subtopics: Array.isArray(t.subtopics)
            ? t.subtopics
                .filter(s => s && typeof s==='object' && typeof s.name==='string' && s.name.trim())
                .map(s => ({ id: s.id || ('sub_'+Math.random().toString(36).slice(2,9)), name: s.name.trim() }))
            : []
        }));
    });
    raw.practice.logs = Array.isArray(raw.practice.logs)
      ? raw.practice.logs
          .filter(l => l && typeof l==='object' && l.subject && l.topicId && !isNaN(parseFloat(l.count)) && parseFloat(l.count) > 0)
          .map(l => ({
            id: l.id || ('plog_'+Math.random().toString(36).slice(2,9)),
            date: l.date || '1970-01-01',
            subject: l.subject,
            topicId: l.topicId,
            subtopicId: l.subtopicId || null,
            source: typeof l.source === 'string' ? l.source.trim() : '',
            count: Math.round(parseFloat(l.count))
          }))
      : [];

    return raw;
  }

  function loadData(){
    let raw;
    try{ raw = JSON.parse(localStorage.getItem(STORAGE_KEY)); }catch(e){ raw = null; }
    return normalizeData(raw);
  }

  // saveData is deliberately local-only. Nothing about saving ever touches the
  // network — the only way data reaches or leaves the cloud is the "Sync now"
  // button, tapped explicitly. This is what makes the whole system simple to
  // reason about: your local save always succeeds instantly, and cloud sync
  // can never interfere with it, race it, or silently overwrite it.
  function saveData(){
    data.lastModified = Date.now();
    snapshotBackup();
    try{
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    }catch(e){
      alert("Couldn't save that change — your browser's storage may be full. Please export a backup right now (Settings → Export backup) before doing anything else, since this last change may not be saved.");
    }
  }

  // ---------- Local safety-net backups (independent of cloud sync) ----------
  const BACKUP_KEY = 'grindLogBackups';
  let lastBackupTime = 0;

  function dataRichness(d){
    if(!d) return 0;
    const testCount = Array.isArray(d.tests) ? d.tests.length : 0;
    const dayCount = d.days && typeof d.days==='object' ? Object.keys(d.days).length : 0;
    const goalLogDays = d.goalLogs && typeof d.goalLogs==='object' ? Object.keys(d.goalLogs).length : 0;
    const practiceLogCount = d.practice && Array.isArray(d.practice.logs) ? d.practice.logs.length : 0;
    const practiceTopicCount = d.practice && d.practice.topics && typeof d.practice.topics==='object'
      ? Object.values(d.practice.topics).reduce((s,arr)=> s + (Array.isArray(arr)?arr.length:0), 0)
      : 0;
    return testCount + dayCount + goalLogDays + practiceLogCount + practiceTopicCount;
  }

  function snapshotBackup(mode){
    try{
      const now = Date.now();
      if(mode !== 'force' && now - lastBackupTime < 5*60*1000) return; // throttle routine snapshots to once per 5 min
      lastBackupTime = now;
      let backups = [];
      try{ backups = JSON.parse(localStorage.getItem(BACKUP_KEY)) || []; }catch(e){ backups = []; }
      backups.push({ ts: now, data: JSON.parse(JSON.stringify(data)) });
      if(backups.length > 12) backups = backups.slice(-12);
      localStorage.setItem(BACKUP_KEY, JSON.stringify(backups));
    }catch(e){ /* backups are best-effort and must never block normal saving */ }
  }

  function renderBackupsList(){
    const wrap = document.getElementById('backupsList');
    if(!wrap) return;
    let backups = [];
