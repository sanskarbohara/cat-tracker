  function toggleTimer(){
    if(data.activeSession){
      // pause -> log session
      const startIso = data.activeSession.start;
      const endIso = new Date().toISOString();
      const durationSec = Math.max(1, Math.floor((new Date(endIso) - new Date(startIso))/1000));

      const SANITY_CAP_SEC = 6*60*60; // 6 hours - generous, but catches "forgot to pause" cases
      if(durationSec > SANITY_CAP_SEC){
        const hrs = (durationSec/3600).toFixed(1);
        const keep = confirm(`This session is showing as ${hrs} hours long — looks like the timer may have been left running (tab open, phone locked, etc). Click OK to log it anyway, or Cancel to discard this session without saving it.`);
        if(!keep){
          data.activeSession = null;
          clearInterval(tickInterval); tickInterval = null;
          saveData();
          renderAll();
          return;
        }
      }

      const key = dateKey(new Date(startIso));
      if(!data.days[key]) data.days[key] = { sessions:[], targetMinutesAtStart: data.settings.dailyTargetMinutes };
      data.days[key].sessions.push({id: 'sess_'+Date.now().toString(36)+Math.random().toString(36).slice(2,6), start:startIso, end:endIso, durationSec, manual:false});
      if(durationSec > data.longestEverSec) data.longestEverSec = durationSec;
      data.activeSession = null;
      clearInterval(tickInterval); tickInterval = null;
      saveData();
      renderAll();
    } else {
      const startIso = new Date().toISOString();
      const key = dateKey(new Date(startIso));
      if(!data.days[key]) data.days[key] = { sessions:[], targetMinutesAtStart: data.settings.dailyTargetMinutes };
      data.activeSession = { start: startIso };
      saveData();
      tickInterval = setInterval(renderTimer, 1000);
      renderAll();
    }
  }
  document.getElementById('timerBtn').addEventListener('click', toggleTimer);

  // resume ticking if a session was already running on load
