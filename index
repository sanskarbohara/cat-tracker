  // ---------- Stats ----------
  function computeStreak(){
    let streak = 0;
    let d = new Date();
    // if today not met yet, start counting from yesterday
    const t = data.days[todayKey()];
    const tTarget = (t && t.targetMinutesAtStart ? t.targetMinutesAtStart : data.settings.dailyTargetMinutes)*60;
    if(!t || dayTotalSec(t) < tTarget){ d.setDate(d.getDate()-1); }
    while(true){
      const k = dateKey(d);
      const dayObj = data.days[k];
      const target = (dayObj && dayObj.targetMinutesAtStart ? dayObj.targetMinutesAtStart : data.settings.dailyTargetMinutes)*60;
      if(dayObj && dayTotalSec(dayObj) >= target && target > 0){
        streak++; d.setDate(d.getDate()-1);
      } else break;
    }
    return streak;
  }
  function renderStats(){
    const streak = computeStreak();
    document.getElementById('statStreak').textContent = streak + (streak===1 ? ' day' : ' days');
    const today = data.days[todayKey()];
    document.getElementById('statLongestToday').textContent = fmtHM(dayLongestSec(today)/60);
    document.getElementById('statLongestEver').textContent = fmtHM(data.longestEverSec/60);

    // 7 day avg (last 7 calendar days, includes zeros)
    let sum7 = 0;
    for(let i=0;i<7;i++){
      const d = new Date(); d.setDate(d.getDate()-i);
      const obj = data.days[dateKey(d)];
      sum7 += dayTotalSec(obj);
    }
    document.getElementById('statAvg7').textContent = fmtHM((sum7/7)/60);

    let totalSec = 0, daysTracked = 0;
    Object.values(data.days).forEach(d=>{ const s = dayTotalSec(d); if(s>0){ totalSec+=s; daysTracked++; } });
    document.getElementById('statTotal').textContent = fmtHM(totalSec/60);
    document.getElementById('statDaysTracked').textContent = daysTracked;
  }

