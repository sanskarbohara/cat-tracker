  // ---------- Timer ----------
  const RING_R = 103, RING_C = 2*Math.PI*103;
  const ringEl = document.getElementById('ringProgress');
  ringEl.style.strokeDasharray = RING_C;

  function currentSessionElapsedSec(){
    if(!data.activeSession) return 0;
    return Math.floor((Date.now() - new Date(data.activeSession.start).getTime())/1000);
  }

  function renderTimer(){
    const btn = document.getElementById('timerBtn');
    const running = !!data.activeSession;
    btn.classList.toggle('running', running);
    document.getElementById('timerState').textContent = running ? 'Tap to pause' : 'Tap to start';

    const liveExtra = running ? currentSessionElapsedSec() : 0;
    document.getElementById('timerDigits').textContent = fmtClock(liveExtra);

    const today = data.days[todayKey()];
    const todaySec = dayTotalSec(today) + liveExtra;
    const targetSec = (today && today.targetMinutesAtStart ? today.targetMinutesAtStart : data.settings.dailyTargetMinutes) * 60;
    const pct = targetSec > 0 ? Math.min(todaySec/targetSec, 1) : 0;
    const offset = RING_C * (1 - pct);
    ringEl.style.strokeDashoffset = offset;
    ringEl.classList.toggle('met', todaySec >= targetSec && targetSec > 0);

    document.getElementById('todayTotal').textContent = fmtHM(todaySec/60);
    document.getElementById('todayTargetLabel').textContent = fmtHM((today && today.targetMinutesAtStart ? today.targetMinutesAtStart : data.settings.dailyTargetMinutes));
