  function dayGoalStats(dateKeyStr){
    const dayLog = data.goalLogs[dateKeyStr];
    if(!dayLog) return null;
    const ids = Object.keys(dayLog);
    if(!ids.length) return null;
    const done = ids.filter(id=>dayLog[id]).length;
    return { total: ids.length, done };
