  function renderSparkline(values){
    if(values.length < 2) return '';
    const w=90, h=26, pad=3;
    const min = Math.min(...values), max = Math.max(...values);
    const range = (max-min) || 1;
    const step = (w-pad*2)/(values.length-1);
    const pts = values.map((v,i)=>{
      const x = pad + i*step;
      const y = h-pad - ((v-min)/range)*(h-pad*2);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    }).join(' ');
    return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><polyline points="${pts}" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  }

  // Least-squares slope of a series against its own index (0,1,2,...). Used only to
  // classify direction (up/flat/down) over the trailing window - not shown as a raw number.
  function linRegSlope(values){
    const n = values.length;
    if(n < 2) return 0;
    const xMean = (n-1)/2;
    const yMean = values.reduce((a,b)=>a+b,0)/n;
    let num=0, den=0;
    for(let i=0;i<n;i++){ num += (i-xMean)*(values[i]-yMean); den += (i-xMean)*(i-xMean); }
    return den===0 ? 0 : num/den;
  }
  // Needs at least 3 percentile points - a trend read on 1-2 points is just noise.
  // Looks at up to the trailing 8 attempts so a rough patch from months ago doesn't
  // keep dragging on a label that should reflect recent form.
  function trendLabel(withPct){
    if(withPct.length < 3) return null;
    const vals = withPct.slice(-8).map(e=>e.percentile);
    const totalMove = linRegSlope(vals) * (vals.length-1);
    if(totalMove > 4) return {label:'Improving', cls:'trend-up'};
    if(totalMove < -4) return {label:'Declining', cls:'trend-down'};
    return {label:'Flat', cls:'trend-flat'};
  }
  function stdev(values){
    const n = values.length;
    const mean = values.reduce((a,b)=>a+b,0)/n;
    return Math.sqrt(values.reduce((s,v)=>s+(v-mean)*(v-mean),0)/n);
  }
  // Spread around the TREND LINE, not around the flat average - a rough spread label,
  // not a formal statistical test. This distinction matters: a clean, steady climb from
  // 40th to 80th percentile has huge stdev around its own average (it's supposed to -
  // that's improvement, not noise) but near-zero scatter around the line it's climbing
  // along. Measuring against the flat mean would wrongly call that "volatile". Measuring
  // residuals from the fitted trend instead only flags real, unpredictable swings -
  // attempts that bounce around independent of any underlying direction.
  function consistencyLabel(withPct){
    if(withPct.length < 3) return null;
    const values = withPct.slice(-8).map(e=>e.percentile);
    const n = values.length;
    const xMean = (n-1)/2;
    const yMean = values.reduce((a,b)=>a+b,0)/n;
    const slope = linRegSlope(values);
    const intercept = yMean - slope*xMean;
    const residuals = values.map((v,i)=> v - (intercept + slope*i));
    const sd = stdev(residuals);
    if(sd < 5) return 'steady';
    if(sd < 12) return 'some swings';
    return 'volatile';
  }
  function buildTrendCardHTML(sec, type){
    const targets = data.settings.targetPercentile || {};
    const entries = sectionEntries(sec, type);
    if(!entries.length){
