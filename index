  // ---------- Today's session list ----------
  function renderSessionList(){
    const ul = document.getElementById('sessionList');
    ul.innerHTML = '';
    const dayKeyForList = todayKey(); // captured once - see note on the delete handler below
    const today = data.days[dayKeyForList];
    const sessions = (today && today.sessions) || [];
    if(!sessions.length){
      ul.innerHTML = '<div class="empty-note">No sessions logged yet today. Hit the timer to start.</div>';
      return;
    }
    sessions.slice().reverse().forEach(s=>{
      const li = document.createElement('li');
      const label = s.manual ? 'Manually added' : `${fmtTime(s.start)} – ${fmtTime(s.end)}`;
      li.innerHTML = `<span class="times">${label}</span><span class="dur mono">${fmtHM(s.durationSec/60)}</span><button class="del-btn" data-session-id="${s.id}" data-day-key="${dayKeyForList}" aria-label="Delete session">✕</button>`;
      ul.appendChild(li);
    });
    // The day key is read from the button itself (captured at render time), not
    // recomputed at click time - if the app is left open across midnight, today's
    // list would otherwise ask deleteSession to look in the NEW day for a session
