  function deletePracticeTopic(subject, topicId){
    const topic = practiceTopicById(subject, topicId);
    if(!topic) return;
    const logCount = data.practice.logs.filter(l=>l.topicId===topicId).length;
    const msg = logCount
      ? `Delete "${topic.name}"? This also removes ${logCount} logged entr${logCount>1?'ies':'y'} under it — that practice history will be gone.`
      : `Delete "${topic.name}"?`;
    if(!confirm(msg)) return;
    data.practice.topics[subject] = data.practice.topics[subject].filter(t=>t.id!==topicId);
    data.practice.logs = data.practice.logs.filter(l=>l.topicId!==topicId);
    if(practiceSelectedTopicId===topicId){ practiceSelectedTopicId=null; practiceSelectedSubtopicId=null; }
    saveData();
    renderPracticePage();
  }

  function deletePracticeSubtopic(subject, topicId, subtopicId){
    const topic = practiceTopicById(subject, topicId);
    if(!topic) return;
    const sub = (topic.subtopics||[]).find(s=>s.id===subtopicId);
    if(!sub) return;
    const logCount = data.practice.logs.filter(l=>l.subtopicId===subtopicId).length;
    const msg = logCount
      ? `Delete "${sub.name}"? ${logCount} logged entr${logCount>1?'ies':'y'} will fold back into the "${topic.name}" total without a sub-topic.`
      : `Delete "${sub.name}"?`;
    if(!confirm(msg)) return;
    topic.subtopics = topic.subtopics.filter(s=>s.id!==subtopicId);
    data.practice.logs.forEach(l=>{ if(l.subtopicId===subtopicId) l.subtopicId=null; });
    if(practiceSelectedSubtopicId===subtopicId) practiceSelectedSubtopicId=null;
    saveData();
    renderPracticePage();
  }

  function beginEditTopic(subject, topicId){
    const row = document.querySelector(`#manageTopicDetail .goal-manage-row[data-topic-id="${topicId}"]`);
    const topic = practiceTopicById(subject, topicId);
    if(!row || !topic) return;
    row.innerHTML = `
      <input type="text" class="topic-edit-input" value="${topic.name.replace(/"/g,'&quot;')}">
      <button class="save-topic-btn">Save</button>
      <button class="cancel-topic-btn">Cancel</button>`;
    const input = row.querySelector('.topic-edit-input');
    input.focus();
    row.querySelector('.save-topic-btn').addEventListener('click', ()=>{
      const newName = input.value.trim();
      if(!newName){ alert('Topic name cannot be empty.'); return; }
      topic.name = newName;
      saveData();
      renderPracticePage();
    });
    row.querySelector('.cancel-topic-btn').addEventListener('click', ()=> renderManageTopicDetail());
  }

  function beginEditSubtopic(subject, topicId, subtopicId){
    const row = document.querySelector(`#manageTopicDetail .goal-manage-row[data-subtopic-id="${subtopicId}"]`);
    const topic = practiceTopicById(subject, topicId);
    const sub = topic && (topic.subtopics||[]).find(s=>s.id===subtopicId);
    if(!row || !sub) return;
    row.innerHTML = `
      <input type="text" class="topic-edit-input" value="${sub.name.replace(/"/g,'&quot;')}">
      <button class="save-topic-btn">Save</button>
      <button class="cancel-topic-btn">Cancel</button>`;
    const input = row.querySelector('.topic-edit-input');
    input.focus();
    row.querySelector('.save-topic-btn').addEventListener('click', ()=>{
      const newName = input.value.trim();
      if(!newName){ alert('Sub-topic name cannot be empty.'); return; }
      sub.name = newName;
      saveData();
      renderPracticePage();
    });
    row.querySelector('.cancel-topic-btn').addEventListener('click', ()=> renderManageTopicDetail());
  }

  function renderPracticeTodayList(){
    const today = todayKey();
    const wrap = document.getElementById('practiceTodayList');
    const emptyNote = document.getElementById('practiceTodayEmpty');
    const todaysLogs = data.practice.logs.filter(l=>l.date===today);
    const totalToday = todaysLogs.reduce((s,l)=>s+l.count,0);
    document.getElementById('practiceTodayLine').textContent =
      totalToday ? `${totalToday} question${totalToday>1?'s':''} logged today` : 'Nothing logged yet today.';
    if(!todaysLogs.length){
      wrap.innerHTML = '';
      emptyNote.classList.remove('hidden');
      return;
    }
    emptyNote.classList.add('hidden');
    wrap.innerHTML = todaysLogs.map(l=>{
      const topic = practiceTopicById(l.subject, l.topicId);
      const topicName = topic ? topic.name : '(deleted topic)';
      const sub = topic && l.subtopicId ? (topic.subtopics||[]).find(s=>s.id===l.subtopicId) : null;
      const label = sub ? `${l.subject} · ${topicName} · ${sub.name}` : `${l.subject} · ${topicName}`;
      const sourceNote = l.source ? ` (${l.source})` : '';
      return `<div class="goal-manage-row" data-log-id="${l.id}">
        <span class="goal-text">${label} — ${l.count}${sourceNote}</span>
        <button class="edit-practice-log-btn" data-log-id="${l.id}">Edit</button>
        <button class="remove del-practice-log-btn" data-log-id="${l.id}">Remove</button>
      </div>`;
    }).join('');
    wrap.querySelectorAll('.edit-practice-log-btn').forEach(btn=>{
      btn.addEventListener('click', ()=> beginEditPracticeLog(btn.dataset.logId));
    });
    wrap.querySelectorAll('.del-practice-log-btn').forEach(btn=>{
      btn.addEventListener('click', ()=> deletePracticeLog(btn.dataset.logId));
    });
  }

  function renderPracticeCoverage(){
    const wrap = document.getElementById('practiceCoverageList');
    const emptyNote = document.getElementById('practiceCoverageEmpty');
    const subjects = ['VARC','Quant','LRDI'];
    const anyTopics = subjects.some(sec => practiceTopicsFor(sec).length);
    if(!anyTopics){
      wrap.innerHTML = '';
      emptyNote.classList.remove('hidden');
      return;
    }
    emptyNote.classList.add('hidden');
    wrap.innerHTML = subjects.map(sec=>{
      const topics = practiceTopicsFor(sec);
      if(!topics.length) return '';
      const totalAll = topics.reduce((s,t)=> s + data.practice.logs.filter(l=>l.topicId===t.id).reduce((ss,l)=>ss+l.count,0), 0);
      const notStartedCount = topics.filter(t=> !data.practice.logs.some(l=>l.topicId===t.id)).length;
      const isOpen = coverageOpenSubject === sec;
      const summaryLine = `${topics.length} topic${topics.length>1?'s':''} · ${totalAll} solved${notStartedCount ? ' · ' + notStartedCount + ' not started' : ''}`;
      const rows = topics.map(t=>{
        const topicLogs = data.practice.logs.filter(l=>l.topicId===t.id);
        const total = topicLogs.reduce((s,l)=>s+l.count,0);
        const lastDate = topicLogs.length ? topicLogs.map(l=>l.date).sort().slice(-1)[0] : null;
        const statusLine = total===0
          ? '<span class="pct-miss">Not started</span>'
          : `${total} solved · last practiced ${daysAgoLabel(lastDate)}`;
        const subRows = (t.subtopics||[]).map(s=>{
          const subTotal = data.practice.logs.filter(l=>l.subtopicId===s.id).reduce((sum,l)=>sum+l.count,0);
          return `<div class="sec-sub" style="padding-left:14px;">${s.name}: ${subTotal}</div>`;
        }).join('');
        return `<div class="trend-card" style="margin-bottom:8px;">
          <div class="sec-name">${t.name}</div>
          <div class="sec-sub">${statusLine}</div>
          ${subRows}
        </div>`;
      }).join('');
      return `<div class="coverage-subject-group" style="margin-bottom:10px;">
        <button type="button" class="coverage-subject-header" data-subject="${sec}">
          <span class="sec-tag ${sec}">${sec}</span>
          <span class="coverage-summary">${summaryLine}</span>
          <span class="coverage-caret">${isOpen?'▾':'▸'}</span>
        </button>
        <div class="coverage-subject-body${isOpen?'':' hidden'}">${rows}</div>
      </div>`;
    }).join('');
    wrap.querySelectorAll('.coverage-subject-header').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const sec = btn.dataset.subject;
        coverageOpenSubject = (coverageOpenSubject === sec) ? null : sec;
        renderPracticeCoverage();
      });
    });
  }

  function renderManageSubjectChips(){
    document.querySelectorAll('#manageSubjectChips .chip').forEach(chip=>{
      chip.classList.toggle('active', chip.dataset.subject === manageSubject);
    });
  }
  function renderManageTopicSelect(){
    const sel = document.getElementById('manageTopicSelect');
    const topics = practiceTopicsFor(manageSubject);
    sel.innerHTML = '<option value="">— pick a topic to manage —</option>' +
      topics.map(t=>`<option value="${t.id}">${t.name}</option>`).join('');
    sel.value = manageSelectedTopicId || '';
  }
  function renderManageTopicDetail(){
    const wrap = document.getElementById('manageTopicDetail');
    if(!manageSelectedTopicId){
      wrap.innerHTML = practiceTopicsFor(manageSubject).length
        ? `<div class="empty-note">Pick a topic above to rename or remove it.</div>`
        : `<div class="empty-note">No topics yet for ${manageSubject}.</div>`;
      return;
    }
    const topic = practiceTopicById(manageSubject, manageSelectedTopicId);
    if(!topic){ manageSelectedTopicId = null; renderManageTopicSelect(); renderManageTopicDetail(); return; }
    const subRows = (topic.subtopics||[]).map(s => `
      <div class="goal-manage-row" data-subtopic-id="${s.id}" style="margin-left:16px; background:var(--surface);">
        <span class="goal-text">${s.name}</span>
        <button class="edit-subtopic-btn" data-subject="${manageSubject}" data-topic-id="${topic.id}" data-subtopic-id="${s.id}">Edit</button>
        <button class="remove del-subtopic-btn" data-subject="${manageSubject}" data-topic-id="${topic.id}" data-subtopic-id="${s.id}">Remove</button>
      </div>`).join('');
    wrap.innerHTML = `
      <div class="goal-manage-row" data-topic-id="${topic.id}">
        <span class="goal-text">${topic.name}</span>
        <button class="edit-topic-btn" data-subject="${manageSubject}" data-topic-id="${topic.id}">Edit</button>
        <button class="remove del-topic-btn" data-subject="${manageSubject}" data-topic-id="${topic.id}">Remove</button>
      </div>
      ${subRows || '<div class="empty-note" style="margin-left:16px;">No sub-topics under this one yet.</div>'}
    `;
    wrap.querySelectorAll('.del-topic-btn').forEach(btn=>{
      btn.addEventListener('click', ()=> deletePracticeTopic(btn.dataset.subject, btn.dataset.topicId));
    });
    wrap.querySelectorAll('.del-subtopic-btn').forEach(btn=>{
      btn.addEventListener('click', ()=> deletePracticeSubtopic(btn.dataset.subject, btn.dataset.topicId, btn.dataset.subtopicId));
    });
    wrap.querySelectorAll('.edit-topic-btn').forEach(btn=>{
      btn.addEventListener('click', ()=> beginEditTopic(btn.dataset.subject, btn.dataset.topicId));
    });
    wrap.querySelectorAll('.edit-subtopic-btn').forEach(btn=>{
      btn.addEventListener('click', ()=> beginEditSubtopic(btn.dataset.subject, btn.dataset.topicId, btn.dataset.subtopicId));
    });
  }
  document.querySelectorAll('#manageSubjectChips .chip').forEach(chip=>{
    chip.addEventListener('click', ()=>{
      manageSubject = chip.dataset.subject;
      manageSelectedTopicId = null;
      renderManageSubjectChips();
      renderManageTopicSelect();
      renderManageTopicDetail();
    });
  });
  document.getElementById('manageTopicSelect').addEventListener('change', (e)=>{
    manageSelectedTopicId = e.target.value || null;
    renderManageTopicDetail();
  });

  function renderPracticePage(){
    // Defends against a stale selection pointing at a topic/subtopic that no longer
    // exists - e.g. after a sync pull, import, reset, or backup restore replaces the
    // whole data set out from under an in-progress selection here. Re-validated on
    // every render rather than patched at each of those call sites individually, so
    // a future one can't be missed the way it was for the sync-conflict button.
    if(practiceSelectedTopicId && !practiceTopicById(practiceSubject, practiceSelectedTopicId)){
      practiceSelectedTopicId = null;
      practiceSelectedSubtopicId = null;
    }
    if(practiceSelectedSubtopicId){
      const topic = practiceSelectedTopicId ? practiceTopicById(practiceSubject, practiceSelectedTopicId) : null;
      if(!topic || !(topic.subtopics||[]).some(s=>s.id===practiceSelectedSubtopicId)){
        practiceSelectedSubtopicId = null;
      }
    }
    // Same defensive validation for the Manage section's independent selection.
    if(manageSelectedTopicId && !practiceTopicById(manageSubject, manageSelectedTopicId)){
      manageSelectedTopicId = null;
    }
    renderPracticeSubjectChips();
    renderPracticeTopicSelect();
    renderPracticeSubtopicSelect();
    renderPracticeTodayList();
    renderPracticeCoverage();
    renderManageSubjectChips();
    renderManageTopicSelect();
    renderManageTopicDetail();
  }

  // ---------- Render all ----------
  function renderAll(){
    renderHeader();
    renderTimer();
    renderSessionList();
    renderStats();
    renderCalendar();
    renderDayDetail();
    renderTargetSection();
    renderBackupsList();
    document.getElementById('catDateInput').value = data.settings.catDate;
  }

  const now = new Date();
  calViewYear = now.getFullYear();
  calViewMonth = now.getMonth();
  renderCalDow();
  renderAll();
  document.getElementById('testDate').value = todayKey();
  renderTestsPage();

  goalCalViewYear = now.getFullYear();
  goalCalViewMonth = now.getMonth();
  renderGoalCalDow();
  renderGoalsPage(); // always safe now - nothing automatic ever touches the network on load
  renderPracticePage();

  // Just show whether a Sync ID is already saved on this device. No network call happens
  // here at all - syncing only ever runs when "Sync now" is tapped, explicitly.
  const savedSyncId = localStorage.getItem('syncId');
  if(savedSyncId){
    document.getElementById('syncIdInput').value = savedSyncId;
    setSyncStatus(`Linked to a Sync ID on this device — tap "Sync now" to send or receive updates.`);
  }

  // keep countdown/date fresh if left open across midnight
  setInterval(renderHeader, 60000);
})();
</script>
</body>
</html>
