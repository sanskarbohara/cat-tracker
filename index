  });

  let data = loadData();
  let calViewYear, calViewMonth; // month is 0-indexed
  let tickInterval = null;
  let selectedDateKey = null;

  const todayKey = () => dateKey(new Date());
  function dateKey(d){
    const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,'0'), day=String(d.getDate()).padStart(2,'0');
    return `${y}-${m}-${day}`;
  }
  function fmtHM(mins){
    mins = Math.round(mins);
    const h = Math.floor(mins/60), m = mins%60;
    return `${h}h ${m}m`;
  }
  function fmtClock(totalSec){
    const h = String(Math.floor(totalSec/3600)).padStart(2,'0');
    const m = String(Math.floor((totalSec%3600)/60)).padStart(2,'0');
    const s = String(Math.floor(totalSec%60)).padStart(2,'0');
    return `${h}:${m}:${s}`;
  }
  function fmtTime(iso){
    const d = new Date(iso);
    let h = d.getHours(); const m = String(d.getMinutes()).padStart(2,'0');
    const ap = h>=12 ? 'PM':'AM'; h = h%12; if(h===0) h=12;
    return `${h}:${m} ${ap}`;
  }
  function dayTotalSec(dayObj){
    if(!dayObj || !dayObj.sessions) return 0;
    return dayObj.sessions.reduce((s,x)=>s+x.durationSec,0);
  }
  function dayLongestSec(dayObj){
    if(!dayObj || !dayObj.sessions || !dayObj.sessions.length) return 0;
    return Math.max(...dayObj.sessions.map(x=>x.durationSec));
  }

  // ---------- Header: date + countdown ----------
  function renderHeader(){
    const now = new Date();
    document.getElementById('todayLabel').textContent = now.toLocaleDateString(undefined,{weekday:'long', month:'long', day:'numeric'});
    const cat = new Date(data.settings.catDate + 'T00:00:00');
