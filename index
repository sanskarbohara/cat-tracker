  function renderTodayGoals(){
    const list = document.getElementById('todayGoalList');
    const goals = activeGoals();
    const key = todayKey();
    if(!data.goalLogs[key]) data.goalLogs[key] = {};
    let backfilled = false;
    goals.forEach(g=>{
      if(!(g.id in data.goalLogs[key])){ data.goalLogs[key][g.id] = false; backfilled = true; }
    });
    if(backfilled){
      // Persist locally, but deliberately don't call saveData()/bump lastModified here -
      // filling in explicit "not done yet" defaults isn't a real change the person made,
      // and shouldn't make this device look "dirty" the next time it syncs.
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    }
    const todayLog = data.goalLogs[key];

    if(!goals.length){
      list.innerHTML = '<div class="empty-note">No active targets — add one below.</div>';
      document.getElementById('goalProgressLine').textContent = '';
      return;
    }
    const doneCount = goals.filter(g=>todayLog[g.id]).length;
    document.getElementById('goalProgressLine').textContent = `${doneCount} of ${goals.length} done today`;
    list.innerHTML = goals.map(g=>{
