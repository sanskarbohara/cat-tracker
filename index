<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grind Log — CAT 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<style>
  :root{
    --bg:#0a0a0f;
    --surface:#15151c;
    --surface-2:#1c1c26;
    --border:#26262f;
    --accent:#f06030;
    --accent-dim:rgba(240,96,48,0.16);
    --success:#7cc576;
    --success-dim:rgba(124,197,118,0.16);
    --warn:#e8b84b;
    --warn-dim:rgba(232,184,75,0.14);
    --text:#eee9e4;
    --text-dim:#8b8890;
    --text-faint:#54525c;
    --radius:14px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{-webkit-tap-highlight-color:transparent;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    min-height:100vh;
    padding-bottom:60px;
  }
  ::selection{background:var(--accent-dim);}
  :focus-visible{outline:2px solid var(--accent); outline-offset:2px;}
  h1,h2,h3{font-family:'Plus Jakarta Sans',sans-serif;}
  .mono{font-family:'JetBrains Mono',monospace;}
  .app{max-width:720px; margin:0 auto; padding:0 18px;}
  /* Generic hide utility. The code treats `.hidden` as a universal "not displayed"
     class on many different elements, but only three of them (.page, .detail-row,
     .day-detail) ever had a matching scoped rule - every other element that got
     this class (the manual-session form, the sync conflict buttons, several
     empty-state notes) was silently NEVER actually hidden, because nothing in the
     stylesheet said so. This single rule covers all of them, and any future one,
     instead of needing a new scoped rule added every time a feature reuses `hidden`.
     !important is deliberate here: this class only ever means "not displayed",
     so nothing should be able to out-specificity it back into view by accident. */
  .hidden{display:none !important;}
  .page.hidden{display:none;}

  /* ---------- Tab bar ---------- */
  .tabbar{
    position:sticky; top:0; z-index:20;
    display:flex; gap:6px;
    background:var(--bg);
    padding:14px 0 10px;
  }
  .tab-btn{
    flex:1; background:var(--surface); border:1px solid var(--border); color:var(--text-dim);
    padding:10px 0; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer;
    font-family:'Plus Jakarta Sans',sans-serif; letter-spacing:0.02em;
  }
  .tab-btn.active{background:var(--accent-dim); color:var(--accent); border-color:var(--accent);}

  /* ---------- Segmented control ---------- */
  .seg-control{display:flex; gap:6px;}
  .seg-btn{
    flex:1; background:var(--surface-2); border:1px solid var(--border); color:var(--text-dim);
    padding:9px 0; border-radius:8px; font-size:13px; cursor:pointer; font-family:'Inter',sans-serif;
  }
  .seg-btn.active{background:var(--accent); color:#0a0a0f; border-color:var(--accent); font-weight:700;}
  .field-row{display:flex; gap:10px;}
  .field-row .field{flex:1;}
  .field input[type="text"]{
    width:100%; background:var(--surface-2); border:1px solid var(--border); color:var(--text);
    padding:10px 12px; border-radius:8px; font-size:14px; font-family:'Inter',sans-serif;
  }
  .field textarea{
    width:100%; background:var(--surface-2); border:1px solid var(--border); color:var(--text);
    padding:10px 12px; border-radius:8px; font-size:12px; font-family:'JetBrains Mono',monospace; resize:vertical;
  }
  .sync-status{font-size:12.5px; color:var(--text-dim); margin-top:10px; line-height:1.5;}
  .sync-status.ok{color:var(--success);}
  .sync-status.err{color:#e87a5a;}

  /* ---------- Section trend cards ---------- */
  .trend-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
  .trend-card{background:var(--surface-2); border-radius:10px; padding:12px 14px;}
  .trend-card .sec-name{font-size:12px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:6px;}
  .trend-card .sec-stats{display:flex; justify-content:space-between; align-items:flex-end;}
  .trend-card .sec-latest{font-family:'JetBrains Mono',monospace; font-size:18px; font-weight:700;}
  .trend-card .sec-sub{font-size:10px; color:var(--text-faint); margin-top:2px;}
  .trend-card svg{display:block;}
  .trend-card.empty .sec-latest{color:var(--text-faint); font-size:12px; font-weight:500; font-family:'Inter',sans-serif;}

  /* ---------- Filter chips ---------- */
  .filter-chips{display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px;}
  .chip{background:var(--surface-2); border:1px solid var(--border); color:var(--text-dim); padding:6px 12px; border-radius:16px; font-size:12px; cursor:pointer;}
  .chip.active{background:var(--accent-dim); color:var(--accent); border-color:var(--accent);}

  /* ---------- Test history table ---------- */
  .table-wrap{overflow-x:auto;}
  table{width:100%; border-collapse:collapse; font-size:12.5px; min-width:660px;}
  thead th{text-align:left; color:var(--text-faint); font-weight:600; text-transform:uppercase; font-size:10px; letter-spacing:0.04em; padding:0 8px 8px;}
  tbody td{padding:9px 8px; border-top:1px solid var(--border);}
  tbody tr:hover{background:var(--surface-2);}
  td.score-cell, td.pct-cell{font-family:'JetBrains Mono',monospace; font-weight:600;}
  td.notes-cell{color:var(--text-dim); max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .del-btn{background:transparent; border:none; color:var(--text-faint); cursor:pointer; font-size:15px; padding:2px 6px;}
  .del-btn:hover{color:#e87a5a;}
  .sec-tag{font-size:10px; padding:2px 7px; border-radius:10px; font-weight:700; text-transform:uppercase;}
  .sec-tag.VARC{background:rgba(124,197,118,0.16); color:var(--success);}
  .sec-tag.Quant{background:rgba(240,96,48,0.16); color:var(--accent);}
  .sec-tag.LRDI{background:rgba(232,184,75,0.14); color:var(--warn);}
  .sec-tag.Overall{background:rgba(139,136,144,0.18); color:var(--text-dim);}

  .mock-card{background:var(--surface-2); border-radius:10px; padding:14px; margin-bottom:12px;}
  .mock-card-header{display:flex; justify-content:space-between; align-items:baseline; margin-bottom:2px; flex-wrap:wrap; gap:6px;}
  .mock-card-title{font-weight:700; font-size:14px; font-family:'Plus Jakarta Sans',sans-serif;}
  .mock-card-date{font-size:12px; color:var(--text-faint);}
  .mock-card-series{font-size:11px; color:var(--text-faint); margin-bottom:10px;}
  .mock-card-notes{font-size:12px; color:var(--text-dim); margin-bottom:10px; font-style:italic;}
  .mock-row{border-top:1px solid var(--border); padding:9px 0; cursor:pointer;}
  .mock-row:first-of-type{border-top:none;}
  .mock-row-summary{display:flex; align-items:center; gap:10px; font-size:13px;}
  .mock-row-summary .sec-tag{flex-shrink:0;}
  .mock-row-summary .mr-score{font-family:'JetBrains Mono',monospace; font-weight:600;}
  .mock-row-summary .mr-pct{font-family:'JetBrains Mono',monospace; color:var(--text-dim); margin-left:auto;}
  .mock-row-summary .mr-acc{font-family:'JetBrains Mono',monospace; color:var(--text-dim); font-size:12px;}
  .mock-row-summary .mr-caret{color:var(--text-faint); font-size:11px;}
  .mock-row-detail{display:none; margin-top:8px; padding:10px; background:var(--surface); border-radius:8px; font-size:12.5px; color:var(--text-dim); line-height:1.7;}
  .mock-row.expanded .mock-row-detail{display:block;}
  .mock-row.expanded .mr-caret{transform:rotate(90deg); display:inline-block;}
  .mock-row-detail b{color:var(--text);}

  .sectional-card{background:var(--surface-2); border-radius:10px; padding:12px; margin-bottom:8px; cursor:pointer;}
  .sectional-card-top{display:flex; align-items:center; gap:10px; font-size:13px;}
  .sectional-card-top .sc-date{color:var(--text-faint); font-size:12px; width:52px; flex-shrink:0;}
  .sectional-card-top .sc-test{flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text-dim); font-size:12px;}
  .sectional-card-top .sc-score{font-family:'JetBrains Mono',monospace; font-weight:600;}
  .sectional-card-top .sc-pct{font-family:'JetBrains Mono',monospace; color:var(--text-dim);}
  .sectional-card-detail{display:none; margin-top:10px; padding:10px; background:var(--surface); border-radius:8px; font-size:12.5px; color:var(--text-dim); line-height:1.7;}
  .sectional-card.expanded .sectional-card-detail{display:block;}
  .sectional-card-detail b{color:var(--text);}
  .sectional-card-detail .del-btn{float:right;}

  .alloc-result{margin-top:14px;}
  .alloc-row{display:flex; justify-content:space-between; align-items:center; gap:10px; padding:9px 10px; background:var(--surface-2); border-radius:8px; margin-bottom:6px; font-size:13px;}
  .alloc-row > div:first-child{flex:1; min-width:0;}
  .alloc-row .alloc-sec{font-weight:600;}
  .alloc-row .alloc-detail{font-size:11px; color:var(--text-faint);}
  .alloc-row .alloc-target{font-family:'JetBrains Mono',monospace; font-weight:700; color:var(--accent); flex-shrink:0;}

  .select-input{
    width:100%; background:var(--surface-2); border:1px solid var(--border); color:var(--text);
    padding:10px 12px; border-radius:8px; font-size:14px; font-family:'Inter',sans-serif; appearance:none;
  }
  .sec-block{border-top:1px solid var(--border); padding-top:12px; margin-top:12px;}
  .sec-block:first-child{border-top:none; padding-top:0; margin-top:0;}
  .sec-block-title{font-size:12px; font-weight:700; color:var(--accent); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;}
  .detail-toggle{
    background:none; border:none; color:var(--text-dim); font-size:12px; cursor:pointer; padding:2px 0 8px;
    text-decoration:underline; text-underline-offset:2px; font-family:'Inter',sans-serif;
  }
  .detail-toggle:hover{color:var(--accent);}
  .detail-row.hidden{display:none;}
  .pct-hit{color:var(--success);}
  .pct-miss{color:#e87a5a;}

  /* ---------- Tests: score-first command centre ---------- */
  .tests-nav{display:flex; gap:6px; margin:4px 0 16px;}
  .tests-nav .seg-btn{flex:0 0 auto; padding:8px 13px;}
  .test-view.hidden{display:none;}
  .test-command{display:flex; flex-direction:column; gap:12px;}
  .test-hero{background:var(--surface-2); border-radius:12px; padding:16px;}
  .test-hero-top{display:flex; justify-content:space-between; align-items:flex-start; gap:14px;}
  .test-kicker{font-size:10px; letter-spacing:.08em; text-transform:uppercase; color:var(--text-faint); font-weight:700; margin-bottom:4px;}
  .test-hero-title{font-family:'Plus Jakarta Sans',sans-serif; font-size:18px; line-height:1.25;}
  .target-field{width:104px; flex-shrink:0;}
  .target-field label{font-size:10px; color:var(--text-faint); text-transform:uppercase; letter-spacing:.05em; display:block; margin-bottom:5px;}
  .target-field input{width:100%; background:var(--surface); border:1px solid var(--accent); border-radius:7px; color:var(--accent); font:700 20px 'JetBrains Mono',monospace; padding:7px 9px;}
  .test-hero-sub{font-size:12px; color:var(--text-dim); line-height:1.5; margin-top:7px;}
  .score-runway{display:grid; grid-template-columns:1.5fr repeat(3,1fr); gap:8px; margin-top:15px;}
  .runway-main,.runway-stat{background:var(--surface); border-radius:8px; padding:11px;}
  .runway-label{font-size:10px; color:var(--text-faint); text-transform:uppercase; letter-spacing:.04em;}
  .runway-value{font:700 22px 'JetBrains Mono',monospace; margin-top:4px;}
  .runway-value small{font:400 11px 'Inter',sans-serif; color:var(--text-dim);}
  .score-progress{height:7px; margin-top:9px; background:var(--border); border-radius:99px; overflow:hidden;}
  .score-progress > span{display:block; height:100%; background:var(--accent); border-radius:99px;}
  .test-panel{background:var(--surface-2); border-radius:10px; padding:14px;}
  .test-panel-head{display:flex; gap:10px; align-items:baseline; justify-content:space-between; margin-bottom:8px;}
  .test-panel-head h2{font-size:14px;}
  .test-panel-head span{font-size:10px; color:var(--text-faint); text-align:right;}
  .score-plan-row{display:grid; grid-template-columns:52px 1fr 70px 58px; gap:8px; align-items:center; border-top:1px solid var(--border); padding:10px 0;}
  .score-plan-row:first-child{border-top:0;}
  .score-plan-sec{font-size:12px; font-weight:700;}
  .score-plan-detail{font-size:11px; line-height:1.45; color:var(--text-dim);}
  .score-plan-score{font:700 16px 'JetBrains Mono',monospace; text-align:right;}
  .score-plan-score span{display:block; color:var(--text-faint); font:400 9px 'Inter',sans-serif; margin-top:2px;}
  .score-plan-acc{font:600 12px 'JetBrains Mono',monospace; text-align:right; color:var(--text-dim);}
  .score-plan-acc.low{color:#e87a5a;}
  .score-plan-acc.good{color:var(--success);}
  .test-insight{border-left:3px solid var(--accent); padding:2px 0 2px 10px; font-size:12px; line-height:1.5; color:var(--text-dim);}
  .test-insight b{color:var(--text);}
  .test-snapshot-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:8px;}
  .snapshot-card{background:var(--surface); border-radius:8px; padding:10px; min-width:0;}
  .snapshot-card .snap-sec{font-size:11px; font-weight:700;}
  .snapshot-card .snap-score{font:700 17px 'JetBrains Mono',monospace; margin-top:7px;}
  .snapshot-card .snap-meta{font-size:10px; line-height:1.4; color:var(--text-faint); margin-top:3px;}
  .next-action{background:var(--accent-dim); border-radius:9px; padding:12px;}
  .next-action .test-kicker{color:var(--accent);}
  .next-action strong{font-size:14px; display:block;}
  .next-action p{font-size:12px; color:var(--text-dim); line-height:1.5; margin-top:4px;}
  .test-empty{font-size:12px; color:var(--text-dim); line-height:1.5; padding:10px 0;}
  #testsLog{margin-top:0;}
  #testsHistory section{margin-top:0;}
  #testsHistory section + section{margin-top:18px;}
  @media(max-width:520px){
    .score-runway{grid-template-columns:1fr 1fr;}
    .runway-main{grid-column:1 / -1;}
    .score-plan-row{grid-template-columns:48px 1fr 58px;}
    .score-plan-acc{grid-column:2 / 4; text-align:left;}
    .test-snapshot-grid{grid-template-columns:1fr;}
  }

  /* ---------- Trend badges ---------- */
  .trend-card .sec-name{display:flex; align-items:center; gap:6px; flex-wrap:wrap;}
  .trend-badge{font-size:9px; padding:2px 6px; border-radius:8px; font-weight:700; text-transform:none; letter-spacing:0; font-family:'Inter',sans-serif;}
  .trend-badge.trend-up{background:var(--success-dim); color:var(--success);}
  .trend-badge.trend-down{background:rgba(232,122,90,0.16); color:#e87a5a;}
  .trend-badge.trend-flat{background:rgba(139,136,144,0.16); color:var(--text-dim);}
  .errtag-chips .chip{padding:5px 10px; font-size:11px;}
  .coverage-subject-header{width:100%; display:flex; align-items:center; gap:8px; background:var(--surface-2); border:none; border-radius:10px; padding:10px 12px; cursor:pointer; text-align:left; font-family:inherit; color:var(--text);}
  .coverage-summary{flex:1; font-size:12px; color:var(--text-dim);}
  .coverage-caret{color:var(--text-faint); font-size:12px; flex-shrink:0;}
  .coverage-subject-body{margin-top:8px;}

  .goal-progress{font-size:13px; color:var(--text-dim); margin-bottom:12px;}
  .goal-item{display:flex; align-items:center; gap:10px; padding:10px; background:var(--surface-2); border-radius:8px; margin-bottom:8px;}
  .goal-item input[type="checkbox"]{width:20px; height:20px; accent-color:var(--accent); flex-shrink:0; cursor:pointer;}
  .goal-item .goal-text{flex:1; font-size:14px;}
  .goal-item.done .goal-text{color:var(--text-dim); text-decoration:line-through;}
  .goal-manage-row{display:flex; align-items:center; gap:6px; padding:9px 10px; background:var(--surface-2); border-radius:8px; margin-bottom:8px;}
  .goal-manage-row .goal-text{flex:1; font-size:13px;}
  .goal-manage-row button{background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:12.5px; padding:5px 8px; white-space:nowrap;}
  .goal-manage-row button:hover{color:var(--accent);}
  .goal-manage-row button.remove:hover{color:#e87a5a;}
  .goal-edit-input{flex:1; background:var(--surface); border:1px solid var(--accent); color:var(--text); padding:7px 9px; border-radius:6px; font-size:13px; font-family:'Inter',sans-serif;}
  .archived-list{margin-top:14px; opacity:0.75;}

  /* ---------- Hero ---------- */
  .hero{padding:28px 0 20px; text-align:center;}
  .hero-top{display:flex; justify-content:space-between; align-items:flex-start; text-align:left; margin-bottom:22px;}
  .date-today{font-size:13px; color:var(--text-dim); letter-spacing:0.02em;}
  .date-today .big{display:block; font-family:'Plus Jakarta Sans',sans-serif; font-size:19px; font-weight:700; color:var(--text); margin-top:2px;}
  .countdown{text-align:right;}
  .countdown .num{display:block; font-family:'JetBrains Mono',monospace; font-size:30px; font-weight:700; color:var(--accent); line-height:1;}
  .countdown .label{font-size:11px; color:var(--text-dim); letter-spacing:0.04em; text-transform:uppercase;}

  .timer-ring{
    position:relative;
    width:230px; height:230px;
    margin:0 auto;
    border-radius:50%;
    background:var(--surface);
    border:none;
    cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    transition:transform 0.15s ease;
  }
  .timer-ring:active{transform:scale(0.98);}
  .timer-ring svg{position:absolute; top:0; left:0; width:100%; height:100%; transform:rotate(-90deg);}
  .timer-ring circle{fill:none; stroke-width:8;}
  .ring-track{stroke:var(--border);}
  .ring-progress{stroke:var(--accent); stroke-linecap:round; transition:stroke-dashoffset 0.4s ease, stroke 0.4s ease;}
  .ring-progress.met{stroke:var(--success);}
  .timer-center{position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; gap:6px;}
  #timerDigits{font-family:'JetBrains Mono',monospace; font-size:32px; font-weight:700; letter-spacing:0.01em;}
  #timerState{font-size:12px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.06em;}
  .timer-ring.running #timerState{color:var(--accent);}
  @media (prefers-reduced-motion: no-preference){
    .timer-ring.running{animation:pulse 2.4s ease-in-out infinite;}
  }
  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 var(--accent-dim);} 50%{box-shadow:0 0 0 14px transparent;}}

  .today-summary{margin-top:20px; font-size:14px; color:var(--text-dim);}
  .today-summary .val{color:var(--text); font-weight:600;}

  /* ---------- Sections ---------- */
  section{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:18px; margin-bottom:14px;}
  section h2{font-size:14px; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-dim); margin-bottom:12px; font-weight:600;}

  #sessionList{list-style:none; display:flex; flex-direction:column; gap:8px;}
  #sessionList li{display:flex; justify-content:space-between; align-items:center; gap:10px; font-size:13px; padding:8px 10px; background:var(--surface-2); border-radius:8px;}
  #sessionList li .times{color:var(--text-dim); flex:1;}
  #sessionList li .dur{font-family:'JetBrains Mono',monospace; font-weight:600;}
  .empty-note{color:var(--text-faint); font-size:13px; padding:6px 2px;}

  .stats-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
  .stat-card{background:var(--surface-2); border-radius:10px; padding:12px 14px;}
  .stat-card .label{font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.04em;}
  .stat-card .value{font-family:'JetBrains Mono',monospace; font-size:19px; font-weight:700; margin-top:4px;}

  /* ---------- Calendar ---------- */
  .cal-header{display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;}
  .cal-header button{background:var(--surface-2); border:1px solid var(--border); color:var(--text); width:30px; height:30px; border-radius:8px; cursor:pointer; font-size:15px;}
  .cal-header .month-label{font-weight:700; font-size:14px; font-family:'Plus Jakarta Sans',sans-serif;}
  .cal-grid{display:grid; grid-template-columns:repeat(7,1fr); gap:5px;}
  .cal-dow{text-align:center; font-size:10px; color:var(--text-faint); padding-bottom:4px; text-transform:uppercase;}
  .cal-cell{aspect-ratio:1; border-radius:8px; display:flex; flex-direction:column; align-items:center; justify-content:center; cursor:pointer; background:var(--surface-2); border:1px solid transparent; font-size:12px; position:relative;}
  .cal-cell.blank{visibility:hidden; cursor:default;}
  .cal-cell .d{font-weight:600;}
  .cal-cell .dot{width:5px; height:5px; border-radius:50%; margin-top:3px; background:transparent;}
  .cal-cell.has-none .dot{background:var(--text-faint); opacity:0.4;}
  .cal-cell.has-low .dot{background:var(--warn);}
  .cal-cell.has-met .dot{background:var(--success);}
  .cal-cell.today{border-color:var(--accent);}
  .cal-cell.selected{background:var(--accent-dim); border-color:var(--accent);}
  .cal-cell:hover{background:var(--border);}

  .day-detail{margin-top:14px; padding-top:14px; border-top:1px solid var(--border);}
  .day-detail.hidden{display:none;}
  .day-detail h3{font-size:14px; margin-bottom:8px;}
  .day-detail .dd-total{font-size:13px; color:var(--text-dim); margin-bottom:8px;}
  .day-detail .dd-total b{color:var(--text);}

  /* ---------- Settings ---------- */
  .field{margin-bottom:14px;}
  .field label{display:block; font-size:12px; color:var(--text-dim); margin-bottom:6px;}
  .field input[type="number"], .field input[type="date"]{
    width:100%; background:var(--surface-2); border:1px solid var(--border); color:var(--text);
    padding:10px 12px; border-radius:8px; font-size:14px; font-family:'JetBrains Mono',monospace;
  }
  .suggest-pill{display:inline-flex; align-items:center; gap:8px; background:var(--success-dim); color:var(--success); font-size:12px; padding:7px 12px; border-radius:20px; margin-top:8px;}
  .suggest-pill button{background:var(--success); color:#0a0a0f; border:none; padding:4px 10px; border-radius:14px; font-size:11px; font-weight:700; cursor:pointer;}
  .btn-row{display:flex; gap:10px; margin-top:6px; flex-wrap:wrap;}
  .btn{background:var(--surface-2); border:1px solid var(--border); color:var(--text); padding:9px 14px; border-radius:8px; font-size:13px; cursor:pointer; font-family:'Inter',sans-serif;}
  .btn:hover{border-color:var(--accent);}
  .btn.danger{color:#e87a5a;}
  .btn.primary{background:var(--accent); color:#0a0a0f; border-color:var(--accent); font-weight:700;}
  input[type="file"]{display:none;}
  footer{text-align:center; font-size:11px; color:var(--text-faint); padding:20px 0 0;}
</style>
</head>
<body>
<div class="app">

