    }).join('');
    wrap.querySelectorAll('.restore-backup-btn').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        // Identify the chosen backup by its timestamp, not its position in the list.
        // Restoring pushes a fresh "current state" safety snapshot first (below), which
        // shifts every earlier backup's array index by one - and drops the oldest entry
        // once the list is at its 12-item cap. Looking the target up by ts (unique and
        // stable) instead of the index captured at render time means the click always
        // restores the backup that was actually clicked, not whatever slid into that
        // slot afterward.
        const ts = parseInt(btn.dataset.ts, 10);
        if(!confirm('Restore this backup? Your current data will be backed up first too, so this itself can be undone.')) return;
        snapshotBackup('force');
        const backupsNow = JSON.parse(localStorage.getItem(BACKUP_KEY) || '[]');
        const target = backupsNow.find(b => b.ts === ts);
        if(!target){
          alert("Couldn't find that backup anymore — it just aged out of the last 12 saved. Nothing was restored, and your current data is untouched.");
          return;
        }
        data = normalizeData(target.data);
        saveData();
        // Same reasoning as Reset/Import: restoring an older backup is a wholesale
        // replacement, so force the next sync to ask explicitly rather than risk it
        // auto-pushing this (possibly older/less-rich) state over the cloud copy.
        localStorage.removeItem('lastSyncedModified');
        localStorage.removeItem('lastSyncedVersion');
        lastKnownVersion = 0;
        renderAll();
        renderTestsPage();
        renderGoalsPage();
        renderPracticePage();
        alert('Restored.');
      });
    });
  }

  // ---------- Cloud Sync (Supabase) ----------
  // Design principle after two real data-loss incidents: NOTHING pulls or overwrites
  // automatically in the background. There is no live listener. Syncing only ever
  // happens when this page is open and either loading or the person taps
  // "Check for updates" - so a background tab can never silently change anything.
  //
  // Safe to keep public: the Supabase URL and anon/publishable key identify the
  // project but grant no access by themselves - real access control is the Postgres
  // row-level-security policy, scoped to knowing the exact Sync ID (a long random
  // string that is never committed to the repo).
  const SUPABASE_URL = 'https://dxyriridthipnnvbrvxs.supabase.co';
  const SUPABASE_ANON_KEY = 'sb_publishable_YmUhYO9uVtpC3uIx0WF1hw_nBM5omuR';
  let sbClient = null;
  function getSbClient(){
    if(!sbClient && typeof supabase !== 'undefined'){
      sbClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    }
    return sbClient;
  }

  let currentSyncId = null;
  let pendingCloudConflict = null;

  function setSyncStatus(msg, kind){
    const el = document.getElementById('cloudSyncStatus');
    if(!el) return;
    el.textContent = msg;
    el.classList.remove('ok','err');
    if(kind==='ok') el.classList.add('ok');
    if(kind==='err') el.classList.add('err');
  }

  let lastKnownVersion = parseInt(localStorage.getItem('lastSyncedVersion') || '0', 10);

  function markSynced(ts, version){
    localStorage.setItem('lastSyncedModified', String(ts || 0));
    if(version !== undefined && version !== null){
      lastKnownVersion = version;
      localStorage.setItem('lastSyncedVersion', String(version));
    }
  }

  // Pushes using optimistic concurrency: the write only lands if nobody else has
  // changed the row since this device last saw it. If two devices somehow tap "Sync
  // now" at the exact same moment, only one write can win - the other is refused
  // outright (never silently overwritten or silently discarded) and told to sync again.
  async function pushToCloud(){
    if(!currentSyncId) return false;
    const client = getSbClient();
    if(!client) return false;
    try{
      if(lastKnownVersion === 0){
        // Brand new Sync ID, or this device has never confirmed a version before.
        // Try to create the row outright first.
        const { error: insertErr } = await client.from('study_data').insert({
          sync_id: currentSyncId, data: data, last_modified: data.lastModified,
          updated_at: new Date().toISOString(), version: 1
        });
        if(!insertErr){
          markSynced(data.lastModified, 1);
          return true;
        }
        // A row already exists under this Sync ID - fall through to the conditional
        // update below, still guarded against version 0 in case that's genuinely current.
      }
      const newVersion = lastKnownVersion + 1;
      const { data: updatedRows, error } = await client.from('study_data')
        .update({ data: data, last_modified: data.lastModified, updated_at: new Date().toISOString(), version: newVersion })
        .eq('sync_id', currentSyncId)
        .eq('version', lastKnownVersion)
        .select();
      if(error) throw error;
      if(!updatedRows || updatedRows.length === 0){
        setSyncStatus('Another device just synced at the same moment — tap Sync now again to reconcile safely.', 'err');
        return false;
      }
      markSynced(data.lastModified, newVersion);
      return true;
    }catch(err){
      setSyncStatus('Sync failed: ' + err.message, 'err');
      return false;
    }
  }

  function applyRemote(remoteBlob, remoteTs, remoteVersion){
    data = normalizeData(remoteBlob);
    if(typeof data.lastModified !== 'number' || data.lastModified <= 0) data.lastModified = remoteTs || 0;
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    markSynced(data.lastModified, remoteVersion);
    renderAll();
    renderTestsPage();
    renderGoalsPage();
    renderPracticePage();
  }

  function showConflictButtons(show){
    const el = document.getElementById('conflictButtons');
    if(el) el.classList.toggle('hidden', !show);
  }

  // The core safety logic. Rather than trusting "whoever has the bigger timestamp",
  // this tracks whether THIS device has made any changes since it last confirmed
  // agreement with the cloud, and whether the cloud has moved since that same point.
  // Only when this device has nothing unsynced to lose does anything auto-apply.
  let syncInProgress = false;

  async function reconcile(syncId){
    if(syncInProgress){
      setSyncStatus('Already syncing — wait for that to finish first.', 'err');
      return;
    }
    if(typeof supabase === 'undefined'){
      setSyncStatus('Cloud library failed to load — check your internet connection and reload the page.', 'err');
      return;
    }
    if(!syncId){
      alert('Enter or generate a Sync ID first.');
      return;
    }

    syncInProgress = true;
    const syncBtn = document.getElementById('syncNowBtn');
    if(syncBtn) syncBtn.disabled = true;
    currentSyncId = syncId;
    const client = getSbClient();
    setSyncStatus('Syncing…');
    showConflictButtons(false);

    try{
      const { data: row, error } = await client
        .from('study_data')
        .select('data,last_modified,version')
        .eq('sync_id', syncId)
        .maybeSingle();
      if(error) throw error;

      if(!row){
        // nothing saved under this Sync ID yet - push this device's copy to create it
        lastKnownVersion = 0;
        const ok = await pushToCloud();
        if(ok) setSyncStatus("Synced — this Sync ID had no data yet, pushed this device's copy ✓", 'ok');
      } else {
        lastKnownVersion = row.version || 0; // always refresh to what the cloud actually holds right now
        const remote = row.data;
        const remoteTs = row.last_modified || 0;
        const lastSynced = parseInt(localStorage.getItem('lastSyncedModified') || '0', 10);
        const localTs = data.lastModified || 0;
        const localDirty = localTs !== lastSynced;
        const cloudMoved = remoteTs !== lastSynced;

        if(!localDirty && !cloudMoved){
          setSyncStatus('Already in sync ✓', 'ok');
          markSynced(localTs, lastKnownVersion);
        } else if(!localDirty && cloudMoved){
          // safe: this device has no unsynced changes of its own to lose
          snapshotBackup('force');
          applyRemote(remote, remoteTs, row.version || 0);
          setSyncStatus('Pulled the newer copy from the cloud ✓', 'ok');
        } else if(localDirty && !cloudMoved){
          // safe: cloud hasn't moved since we last agreed, only this device has new stuff
          const ok = await pushToCloud();
          if(ok){
            setSyncStatus("Pushed this device's changes to the cloud ✓", 'ok');
          } else {
            // pushToCloud already set a specific status (version race or network error) -
            // do NOT overwrite it with a false claim of success
          }
        } else {
          // both sides changed since they last agreed - genuine conflict, ask explicitly
          pendingCloudConflict = { data: remote, last_modified: remoteTs, version: row.version || 0 };
          const localRichness = dataRichness(data);
          const remoteRichness = dataRichness(remote);
          const localWhen = localTs ? new Date(localTs).toLocaleString(undefined,{dateStyle:'medium',timeStyle:'short'}) : 'unknown';
          const remoteWhen = remoteTs ? new Date(remoteTs).toLocaleString(undefined,{dateStyle:'medium',timeStyle:'short'}) : 'unknown';
          const detailEl = document.getElementById('conflictDetail');
          if(detailEl) detailEl.textContent =
            `Both this device and the cloud have changes since they last matched. This device: ${localRichness} records, last saved ${localWhen}. Cloud: ${remoteRichness} records, last saved ${remoteWhen}. Pick which to keep — the other side will be overwritten.`;
          setSyncStatus('Changes on both sides — pick which to keep below.', 'err');
          showConflictButtons(true);
        }
      }
      localStorage.setItem('syncId', syncId);
    }catch(err){
      setSyncStatus('Could not reach Supabase: ' + err.message + ' — double check your connection.', 'err');
    }
    syncInProgress = false;
    if(syncBtn) syncBtn.disabled = false;
  }

  document.getElementById('useCloudBtn').addEventListener('click', ()=>{
    if(!pendingCloudConflict) return;
    snapshotBackup('force');
    applyRemote(pendingCloudConflict.data, pendingCloudConflict.last_modified, pendingCloudConflict.version);
    setSyncStatus('Switched to the cloud copy ✓', 'ok');
    showConflictButtons(false);
    pendingCloudConflict = null;
  });
  document.getElementById('useLocalBtn').addEventListener('click', async ()=>{
    if(confirm("This overwrites the cloud copy with what's on this device. Continue?")){
      // use the version we just saw when the conflict was detected, so the push is
      // still safely conditional rather than blind
      lastKnownVersion = pendingCloudConflict ? (pendingCloudConflict.version || 0) : lastKnownVersion;
      pendingCloudConflict = null;
      showConflictButtons(false);
      const ok = await pushToCloud();
      if(ok) setSyncStatus("This device's copy is now the cloud copy ✓", 'ok');
      // if it failed, pushToCloud already set a specific, accurate status message
    }
  });

  function disconnectCloud(){
    currentSyncId = null;
    lastKnownVersion = 0;
    localStorage.removeItem('syncId');
    localStorage.removeItem('lastSyncedModified');
    localStorage.removeItem('lastSyncedVersion');
    document.getElementById('syncIdInput').value = '';
    setSyncStatus('No Sync ID saved on this device yet.');
  }

  function randomSyncId(){
    const bytes = new Uint8Array(16);
    (window.crypto || window.msCrypto).getRandomValues(bytes);
    return Array.from(bytes).map(b=>b.toString(16).padStart(2,'0')).join('');
  }

  document.getElementById('genSyncIdBtn').addEventListener('click', ()=>{
