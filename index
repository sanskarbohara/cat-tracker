  // ---------- Percentile allocation (statistical estimate, not an official CAT formula) ----------
  // Standard normal CDF - Abramowitz & Stegun approximation 26.2.17, accurate to ~7.5e-8.
  // A well-established formula, not something invented for this app.
  function normalCDF(z){
    const b1=0.319381530, b2=-0.356563782, b3=1.781477937, b4=-1.821255978, b5=1.330274429;
    const p=0.2316419, c=0.39894228;
    if(z >= 0){
      const t = 1/(1+p*z);
      return 1 - c*Math.exp(-z*z/2)*t*(t*(t*(t*(t*b5+b4)+b3)+b2)+b1);
    } else {
      return 1 - normalCDF(-z);
    }
  }
  // Inverse standard normal CDF (probit) - Peter Acklam's algorithm, a well-known,
  // widely used rational approximation, accurate to about 1.15e-9.
  function inverseNormalCDF(p){
    if(p <= 0) return -Infinity;
    if(p >= 1) return Infinity;
    const a = [-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02, 1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00];
    const b = [-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02, 6.680131188771972e+01, -1.328068155288572e+01];
    const c = [-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00, -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00];
    const d = [7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00, 3.754408661907416e+00];
    const p_low = 0.02425, p_high = 1 - p_low;
    let q, r;
    if(p < p_low){
      q = Math.sqrt(-2*Math.log(p));
      return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
    } else if(p <= p_high){
      q = p - 0.5; r = q*q;
      return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q / (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1);
    } else {
      q = Math.sqrt(-2*Math.log(1-p));
      return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
    }
  }

  // Current standing per section. Prefers full-mock percentiles when any exist,
  // because a mock (three sections back-to-back, real time pressure, fatigue by the
  // third section) is a much closer proxy for exam day than an isolated sectional
  // drill done fresh with full attention on one section alone - sectional-only
  // practice tends to read optimistic next to how the same section performs inside
  // a full mock. Falls back to blending in sectional attempts only when no mock
  // percentile is logged yet for that section, so there's still something to work
  // with early on. The basis (and how many attempts it's built on) is returned so
  // the UI can say which one it used, rather than presenting a blended number as if
  // it were mock-grade evidence.
  function sectionCurrentAvgPercentile(section){
    const mockEntries = data.tests.filter(t=>t.section===section && t.type==='mock' && t.percentile!==null && t.percentile!==undefined);
    if(mockEntries.length){
      return { value: mockEntries.reduce((s,e)=>s+e.percentile,0)/mockEntries.length, basis:'mock', n: mockEntries.length };
    }
    const allEntries = data.tests.filter(t=>t.section===section && t.percentile!==null && t.percentile!==undefined);
    if(!allEntries.length) return null;
    return { value: allEntries.reduce((s,e)=>s+e.percentile,0)/allEntries.length, basis:'sectional', n: allEntries.length };
  }

  // Score-based helpers. Unlike percentile, score isn't relative to who else sat a
  // given mock, so these are plain averages/maximums over logged data - no fitting,
  // no extrapolation, nothing that can produce a number further from reality the
  // further out you ask it to reach. Mock-preferred, same reasoning as percentile:
  // a mock under real time pressure across all sections reads more honestly than an
  // isolated sectional drill, so it's used whenever any exist for that section.
  function sectionCurrentAvgScore(section){
    const mockEntries = data.tests.filter(t=>t.section===section && t.type==='mock');
    if(mockEntries.length){
      return { value: mockEntries.reduce((s,e)=>s+e.score,0)/mockEntries.length, basis:'mock', n: mockEntries.length };
    }
    const allEntries = data.tests.filter(t=>t.section===section);
    if(!allEntries.length) return null;
    return { value: allEntries.reduce((s,e)=>s+e.score,0)/allEntries.length, basis:'sectional', n: allEntries.length };
  }
  function sectionBestScore(section){
    const entries = data.tests.filter(t=>t.section===section);
    if(!entries.length) return null;
    return Math.max(...entries.map(e=>e.score));
  }
  function sectionAvgAccuracy(section){
    const entries = data.tests.filter(t=>t.section===section && t.attempted && t.correct!==null && t.correct!==undefined);
    if(!entries.length) return null;
    return { value: entries.reduce((s,e)=>s+(e.correct/e.attempted*100),0)/entries.length, n: entries.length };
  }

  // Best-ever percentile and accuracy logged for a section, across sectionals and
  // mocks alike. This is the one number in this whole calculator that isn't a
  // statistical guess about the future - it's a fact about what you've already
  // proven you can do at least once. Used as the grounding reference for very high
  // targets (99.9+), where the population being aimed at is too small for any
  // fixed score to reliably promise anything (see EXTREME_TARGET_THRESHOLD below).
  function sectionPeakPercentile(section){
    const entries = data.tests.filter(t=>t.section===section && t.percentile!==null && t.percentile!==undefined);
    if(!entries.length) return null;
    return Math.max(...entries.map(e=>e.percentile));
  }
  function sectionBestAccuracy(section){
    const entries = data.tests.filter(t=>t.section===section && t.attempted && t.correct!==null && t.correct!==undefined);
    if(!entries.length) return null;
    return Math.max(...entries.map(e=> e.correct/e.attempted*100));
  }

  // Above this, the calculator's normal-distribution model is aiming at a population
  // of only a few dozen people nationally (99.99%ile of ~3 lakh test-takers is
  // roughly the top 30) - too small and too non-smooth for a bell-curve estimate, or
  // any fixed score, to reliably promise anything. The math below still runs (it's
  // the same honest estimate either way), but the UI treats the result as a rough
  // compass rather than a number to bank on once the target crosses this line.
  const EXTREME_TARGET_THRESHOLD = 99.9;

  function computeAllocation(overallTargetPct){
    const sections = ['VARC','Quant','LRDI'];
    const current = {};
    for(const sec of sections){
      current[sec] = sectionCurrentAvgPercentile(sec);
    }
    const missing = sections.filter(sec => current[sec]===null);
    if(missing.length){
      return { error: `Log at least one percentile-tracked attempt for ${missing.join(' and ')} first — there's nothing to base a personalized split on yet.` };
    }
    const extremeTarget = overallTargetPct >= EXTREME_TARGET_THRESHOLD;

    const zTarget = inverseNormalCDF(Math.min(0.9999, Math.max(0.001, overallTargetPct/100)));
    const zCurrent = {};
    for(const sec of sections) zCurrent[sec] = inverseNormalCDF(Math.min(0.9999, Math.max(0.001, current[sec].value/100)));

    // Same absolute z-score boost applied to every section, derived from how far your
    // current 3-section average sits from the target. This preserves each section's
    // relative strength (a strong section is still asked to push further; a weak one
    // gets a real but achievable stretch) rather than earlier flawed logic that gave
    // every below-target section an identical target regardless of how far behind it was.
    const avgZCurrent = sections.reduce((s,sec)=>s+zCurrent[sec],0) / sections.length;
    const deltaZ = zTarget - avgZCurrent;

    const result = {};
    if(deltaZ <= 0){
      // Already tracking to clear this goal on average - show current standing as-is,
      // no artificial reduction implied.
      for(const sec of sections) result[sec] = { current: current[sec].value, basis: current[sec].basis, n: current[sec].n, target: current[sec].value, onTrack: true, peak: sectionPeakPercentile(sec), bestAcc: sectionBestAccuracy(sec) };
      return { sections: result, alreadyOnTrack: true, extremeTarget };
    }
    for(const sec of sections){
      const targetZ = zCurrent[sec] + deltaZ;
      const pct = normalCDF(targetZ) * 100;
      const target = Math.max(1, Math.min(99.99, pct));
      result[sec] = { current: current[sec].value, basis: current[sec].basis, n: current[sec].n, target, gap: target - current[sec].value, peak: sectionPeakPercentile(sec), bestAcc: sectionBestAccuracy(sec) };
    }
    return { sections: result, extremeTarget };
  }

  function renderAllocationResult(){
    const input = document.getElementById('overallTargetInput');
    const box = document.getElementById('percentileAllocationResult');
    const val = parseFloat(input.value);
    if(!input.value || isNaN(val)){ box.innerHTML = ''; return; }
    if(val < 1 || val > 99.99){
      box.innerHTML = '<div class="empty-note">Enter something between 1 and 99.99.</div>';
      return;
    }
    const result = computeAllocation(val);
    if(result.error){
      box.innerHTML = `<div class="empty-note">${result.error}</div>`;
      return;
    }
    if(!data.settings.targetPercentile) data.settings.targetPercentile = {};
    data.settings.targetPercentile.Overall = val;
    let html = '<div class="alloc-result">';
    if(result.extremeTarget){
      html += `<div class="empty-note" style="margin-bottom:10px;">At ${val}%ile you're aiming at roughly the top 30 test-takers nationally — a group too small for any fixed score, mock percentile, or bell-curve estimate to reliably promise. The split below uses the same honest math as any other target, so treat it as a rough compass, not a number to bank on. The one thing you fully control is closing the gap to your own best-ever section performance — that's shown alongside each target below.</div>`;
    }
    if(result.alreadyOnTrack){
      html += '<div class="empty-note" style="margin-bottom:8px;">Your current averages already clear this target — here\'s where each section stands.</div>';
    }
    ['VARC','Quant','LRDI'].forEach(sec=>{
      const r = result.sections[sec];
      data.settings.targetPercentile[sec] = Math.round(r.target*100)/100;
      const basisNote = r.basis==='mock'
        ? `${r.n} mock${r.n>1?'s':''}`
        : `${r.n} sectional${r.n>1?'s':''}, no mocks yet`;
      let detail = result.alreadyOnTrack
        ? `currently averaging ${r.current.toFixed(2)}%ile (${basisNote})`
        : `${r.current.toFixed(2)}%ile now (${basisNote}) · +${r.gap.toFixed(2)} needed`;
      if(result.extremeTarget){
        const bestBits = [];
        if(r.peak!==null) bestBits.push(`best ever ${r.peak.toFixed(2)}%ile`);
        if(r.bestAcc!==null) bestBits.push(`best accuracy ${r.bestAcc.toFixed(0)}%`);
        if(bestBits.length) detail += ` · ${bestBits.join(' · ')}`;
      }
      html += `<div class="alloc-row">
        <div><div class="alloc-sec">${sec}</div><div class="alloc-detail">${detail}</div></div>
        <div class="alloc-target">${r.target.toFixed(2)}%ile</div>
      </div>`;
    });
    html += '</div>';
    box.innerHTML = html;
    saveData();
    renderSectionalTrendCards();
    renderMockTrendCards();
  }
  function renderScoreGapResult(){
    const input = document.getElementById('targetScoreInput');
    const box = document.getElementById('scoreGapResult');
    const val = parseFloat(input.value);
    if(!input.value || isNaN(val)){
      box.innerHTML = '';
      if(data.settings.targetScore !== null){
        data.settings.targetScore = null;
        saveData();
      }
      return;
    }
    data.settings.targetScore = val;

    let html = '<div class="alloc-result">';
    const overall = sectionCurrentAvgScore('Overall');
    const overallBest = sectionBestScore('Overall');
    if(overall){
      const gap = val - overall.value;
      const basisNote = overall.basis==='mock' ? `${overall.n} mock${overall.n>1?'s':''}` : `${overall.n} sectional${overall.n>1?'s':''}`;
      let detail = `avg ${overall.value.toFixed(1)} (${basisNote})`;
      if(overallBest!==null) detail += ` · best ${overallBest}`;
      detail += gap > 0 ? ` · +${gap.toFixed(1)} needed` : ` · already averaging your target`;
      html += `<div class="alloc-row">
        <div><div class="alloc-sec">Overall</div><div class="alloc-detail">${detail}</div></div>
        <div class="alloc-target">${val}</div>
      </div>`;
    } else {
      html += `<div class="empty-note" style="margin-bottom:8px;">Log a full mock with an Overall score filled in to see your gap to this target.</div>`;
    }

    ['VARC','Quant','LRDI'].forEach(sec=>{
      const cur = sectionCurrentAvgScore(sec);
      if(!cur) return;
      const best = sectionBestScore(sec);
      const acc = sectionAvgAccuracy(sec);
      const basisNote = cur.basis==='mock' ? `${cur.n} mock${cur.n>1?'s':''}` : `${cur.n} sectional${cur.n>1?'s':''}`;
      let detail = `avg score ${cur.value.toFixed(1)} (${basisNote})`;
      if(acc) detail += ` · avg accuracy ${acc.value.toFixed(0)}%`;
      if(best!==null) detail += ` · best ${best}`;
      html += `<div class="alloc-row">
        <div><div class="alloc-sec">${sec}</div><div class="alloc-detail">${detail}</div></div>
      </div>`;
    });
    html += '</div>';
    box.innerHTML = html;
    saveData();
  }
  function latestTest(section, type){
    const entries = sectionEntries(section, type);
    return entries.length ? entries[entries.length-1] : null;
  }
  function accuracyOf(entry){
    return entry && entry.attempted>0 && entry.correct!==null && entry.correct!==undefined ? entry.correct/entry.attempted*100 : null;
  }
  function averageAttempts(section, basis){
    const entries = sectionEntries(section, basis==='mock'?'mock':null).filter(t=>t.attempted>0 && t.correct!==null && t.correct!==undefined);
    return entries.length ? entries.reduce((sum,t)=>sum+t.attempted,0)/entries.length : null;
  }
  function sectionScorePlan(target){
    const sections = ['VARC','LRDI','Quant'];
    const current = Object.fromEntries(sections.map(sec=>[sec,sectionCurrentAvgScore(sec)]));
    if(sections.some(sec=>!current[sec])) return null;
    const baseline = sections.reduce((sum,sec)=>sum+current[sec].value,0);
    const gap = Math.max(0,target-baseline);
    const capacity = Object.fromEntries(sections.map(sec=>[sec,Math.max(0,(sectionBestScore(sec)||current[sec].value)-current[sec].value)]));
    const totalCapacity = sections.reduce((sum,sec)=>sum+capacity[sec],0);
    return {sections,current,baseline,gap,targetFor(sec){ return current[sec].value + (gap ? gap*(totalCapacity ? capacity[sec]/totalCapacity : 1/sections.length) : 0); }};
  }
  function renderScoreGapResult(){
    const input = document.getElementById('targetScoreInput');
    const box = document.getElementById('scoreGapResult');
    const target = parseFloat(input.value);
    if(!input.value || isNaN(target) || target<=0){ box.innerHTML='<div class="test-empty">Enter a score target to build your test plan.</div>'; return; }
    if(data.settings.targetScore!==target){ data.settings.targetScore=target; saveData(); }
    const overall = sectionCurrentAvgScore('Overall');
    const best = sectionBestScore('Overall');
    const latest = latestTest('Overall','mock');
    if(!overall){
      box.innerHTML = `<div class="score-runway"><div class="runway-main"><div class="runway-label">Mock score baseline</div><div class="runway-value">— <small>/ ${target}</small></div><div class="score-progress"><span style="width:0%"></span></div></div><div class="runway-stat"><div class="runway-label">Gap</div><div class="runway-value">—</div></div><div class="runway-stat"><div class="runway-label">Best mock</div><div class="runway-value">—</div></div><div class="runway-stat"><div class="runway-label">Latest mock</div><div class="runway-value">—</div></div></div><div class="test-empty">Log one full mock with the Overall score filled in. Until then, use sectionals as your baseline.</div>`;
      return;
    }
    const gap=target-overall.value, progress=Math.max(0,Math.min(100,overall.value/target*100));
    box.innerHTML = `<div class="score-runway"><div class="runway-main"><div class="runway-label">Current mock average</div><div class="runway-value">${overall.value.toFixed(1)} <small>/ ${target}</small></div><div class="score-progress"><span style="width:${progress}%"></span></div></div><div class="runway-stat"><div class="runway-label">Gap to target</div><div class="runway-value">${gap>0?'+'+gap.toFixed(1):'On track'}</div></div><div class="runway-stat"><div class="runway-label">Best mock</div><div class="runway-value">${best===null?'—':best}</div></div><div class="runway-stat"><div class="runway-label">Latest mock</div><div class="runway-value">${latest?latest.score:'—'}</div></div></div>`;
  }
  function renderTestCommandCenter(){
    renderScoreGapResult();
    const target=parseFloat(document.getElementById('targetScoreInput').value), plan=sectionScorePlan(target);
    const planBox=document.getElementById('sectionScorePlan'), insight=document.getElementById('testsInsight'), action=document.getElementById('nextTestAction');
    if(!plan){
      planBox.innerHTML='<div class="test-empty">Log scores for VARC, LRDI and Quant to see a section-by-section plan.</div>';
      insight.textContent='Use sectionals to create a baseline; switch to full mocks once you have them.';
      action.innerHTML='<div class="test-kicker">Next action</div><strong>Log a full mock or one sectional in each section.</strong><p>That gives this dashboard a useful score and accuracy baseline.</p>';
    }else{
      let priority=null;
      planBox.innerHTML=plan.sections.map(sec=>{
        const cur=plan.current[sec], planned=plan.targetFor(sec), uplift=planned-cur.value, accuracy=sectionAvgAccuracy(sec), acc=accuracy?accuracy.value:null;
        const urgency=uplift*2+(acc===null?10:Math.max(0,75-acc));
        if(!priority || urgency>priority.urgency) priority={sec,uplift,acc,basis:cur.basis,urgency};
        const cls=acc===null?'':acc>=75?'good':acc<65?'low':'';
        return `<div class="score-plan-row"><div class="score-plan-sec">${sec}</div><div class="score-plan-detail">${cur.basis==='mock'?'Mock':'Sectional'} avg ${cur.value.toFixed(1)} · plan for +${uplift.toFixed(1)}</div><div class="score-plan-score">${planned.toFixed(0)}<span>planned score</span></div><div class="score-plan-acc ${cls}">${acc===null?'—':acc.toFixed(0)+'%'}<span>accuracy</span></div></div>`;
      }).join('');
      insight.innerHTML=`<b>Planning guide:</b> ${plan.baseline.toFixed(1)} current section score → ${target}. The uplift leans toward sections where you have the most room to regain your own best score; it is a training plan, not a CAT cutoff prediction.`;
      const attempts=averageAttempts(priority.sec,priority.basis);
      const tagged=sectionEntries(priority.sec,priority.basis==='mock'?'mock':null).filter(t=>t.errorTag);
      const counts=tagged.reduce((all,t)=>{all[t.errorTag]=(all[t.errorTag]||0)+1; return all;},{});
      const common=Object.keys(counts).sort((a,b)=>counts[b]-counts[a])[0];
      if(priority.acc!==null && priority.acc<75){
        const marks=attempts?(attempts*.2).toFixed(1):null;
        action.innerHTML=`<div class="test-kicker">Next action</div><strong>${priority.sec}: improve selection before adding attempts.</strong><p>Run one timed sectional and target accuracy above ${Math.min(90,Math.ceil(priority.acc/5)*5+5)}%.${marks?` At your usual ${Math.round(attempts)} attempts, a 5-point accuracy gain is roughly ${marks} more marks.`:''}${common?` Most repeated logged issue: ${common}.`:''}</p>`;
      }else{
        action.innerHTML=`<div class="test-kicker">Next action</div><strong>${priority.sec}: add score without sacrificing accuracy.</strong><p>Your next planned gain is +${priority.uplift.toFixed(1)} marks.${common?` Review ${common} errors first.`:' Log attempted, correct and wrong after the sectional so this becomes more specific.'}</p>`;
      }
    }
    document.getElementById('sectionalCheckins').innerHTML=['VARC','LRDI','Quant'].map(sec=>{
      const latest=latestTest(sec,'sectional'), acc=accuracyOf(latest);
      return !latest?`<div class="snapshot-card"><div class="snap-sec">${sec}</div><div class="snap-score">—</div><div class="snap-meta">No sectional logged</div></div>`:`<div class="snapshot-card"><div class="snap-sec">${sec}</div><div class="snap-score">${latest.score}</div><div class="snap-meta">${latest.testName||'Latest sectional'}<br>${acc===null?'Add attempted + correct for accuracy':acc.toFixed(0)+'% accuracy'}${latest.errorTag?` · ${latest.errorTag}`:''}</div></div>`;
    }).join('');
  }
