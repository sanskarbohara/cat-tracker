    const last = entries[entries.length-1];
    const withPct = entries.filter(e=>e.percentile!==null && e.percentile!==undefined);
    const allTimeAvg = withPct.length ? (withPct.reduce((s,e)=>s+e.percentile,0)/withPct.length) : null;
    const last5 = withPct.slice(-5);
    const last5Avg = last5.length ? (last5.reduce((s,e)=>s+e.percentile,0)/last5.length) : null;
    const peakPct = withPct.length ? Math.max(...withPct.map(e=>e.percentile)) : null;
    const withAcc = entries.filter(e=>e.attempted && e.correct!==null && e.correct!==undefined);
    const avgAcc = withAcc.length ? (withAcc.reduce((s,e)=>s+(e.correct/e.attempted*100),0)/withAcc.length) : null;
    const avgAttempted = withAcc.length ? (withAcc.reduce((s,e)=>s+e.attempted,0)/withAcc.length) : null;
    const trend = trendLabel(withPct);
    const consistency = consistencyLabel(withPct);
    // Sparkline is percentile-only, on purpose - raw scores aren't comparable across
    // different test series (different scales, different negative-marking schemes),
    // so a line mixing them would show a shape that means nothing.
    const sparkVals = withPct.slice(-10).map(e=>e.percentile);

    const target = targets[sec];
    let latestDisplay, hitClass = '';
    if(last.percentile!==null && last.percentile!==undefined){
      latestDisplay = last.percentile+'%ile';
      if(target){ hitClass = last.percentile >= target ? 'pct-hit' : 'pct-miss'; }
    } else {
      latestDisplay = last.score;
    }
    const targetNote = target ? ` · target ${target}%ile` : '';
    const trendBadge = trend ? `<span class="trend-badge ${trend.cls}">${trend.label}</span>` : '';

    let avgLine;
    if(allTimeAvg===null){
      avgLine = `best score ${Math.max(...entries.map(e=>e.score))}${targetNote} · log percentile to unlock trend stats`;
    } else if(last5.length < withPct.length){
      avgLine = `${allTimeAvg.toFixed(2)}%ile all-time · ${last5Avg.toFixed(2)}%ile last ${last5.length}${targetNote}`;
    } else {
      avgLine = `avg ${allTimeAvg.toFixed(2)}%ile${targetNote}`;
    }
    const peakLine = peakPct!==null ? `peak ${peakPct.toFixed(2)}%ile${consistency ? ' · '+consistency : ''}` : '';
    const accLine = avgAcc!==null ? `avg accuracy ${avgAcc.toFixed(0)}% on ~${Math.round(avgAttempted)} attempted` : '';

    return `<div class="trend-card">
      <div class="sec-name">${sec} · ${entries.length} attempt${entries.length>1?'s':''} ${trendBadge}</div>
      <div class="sec-stats">
        <div>
          <div class="sec-latest ${hitClass}">${latestDisplay}</div>
          <div class="sec-sub">${avgLine}</div>
          ${peakLine ? `<div class="sec-sub">${peakLine}</div>` : ''}
          ${accLine ? `<div class="sec-sub">${accLine}</div>` : ''}
        </div>
        ${renderSparkline(sparkVals)}
      </div>
    </div>`;
  }

