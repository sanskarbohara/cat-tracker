  function deleteSession(dateKeyStr, sessionId){
    if(!confirm('Delete this session?')) return;
    const day = data.days[dateKeyStr];
    if(!day) return;
    day.sessions = day.sessions.filter(s=>s.id!==sessionId);
    let recalculated = 0;
    Object.values(data.days).forEach(d=>{
      (d.sessions||[]).forEach(s=>{ if(s.durationSec > recalculated) recalculated = s.durationSec; });
    });
    data.longestEverSec = recalculated;
    saveData();
    renderAll();
  }

  document.getElementById('manualSessionToggle').addEventListener('click', ()=>{
    const form = document.getElementById('manualSessionForm');
