  function renderGoalCalendar(){
    const grid = document.getElementById('goalCalGrid');
    grid.innerHTML = '';
    const label = new Date(goalCalViewYear, goalCalViewMonth, 1).toLocaleDateString(undefined,{month:'long', year:'numeric'});
    document.getElementById('goalMonthLabel').textContent = label;

    const firstDow = new Date(goalCalViewYear, goalCalViewMonth, 1).getDay();
    const daysInMonth = new Date(goalCalViewYear, goalCalViewMonth+1, 0).getDate();
    const tKey = todayKey();

    for(let i=0;i<firstDow;i++){
      const blank = document.createElement('div');
      blank.className = 'cal-cell blank';
      grid.appendChild(blank);
    }
    for(let day=1; day<=daysInMonth; day++){
      const d = new Date(goalCalViewYear, goalCalViewMonth, day);
      const key = dateKey(d);
      const stats = dayGoalStats(key);
      const cell = document.createElement('div');
      cell.className = 'cal-cell';
      if(key === tKey) cell.classList.add('today');
      if(key === goalSelectedDateKey) cell.classList.add('selected');

      if(!stats){ cell.classList.add('has-none'); }
      else if(stats.done >= stats.total){ cell.classList.add('has-met'); }
      else { cell.classList.add('has-low'); }

      cell.innerHTML = `<span class="d">${day}</span><span class="dot"></span>`;
      cell.addEventListener('click', ()=>{ goalSelectedDateKey = key; renderGoalCalendar(); renderGoalDayDetail(); });
      grid.appendChild(cell);
    }
  }

  function renderGoalDayDetail(){
    const panel = document.getElementById('goalDayDetail');
    if(!goalSelectedDateKey){ panel.classList.add('hidden'); return; }
    panel.classList.remove('hidden');
    const d = new Date(goalSelectedDateKey + 'T00:00:00');
    const niceDate = d.toLocaleDateString(undefined,{weekday:'long', month:'long', day:'numeric', year:'numeric'});
    const dayLog = data.goalLogs[goalSelectedDateKey];

    let html = `<h3>${niceDate}</h3>`;
    if(!dayLog || !Object.keys(dayLog).length){
      html += '<div class="empty-note">No targets logged this day.</div>';
    } else {
      html += Object.keys(dayLog).map(gid=>{
        const goal = goalById(gid);
